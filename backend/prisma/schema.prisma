// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// lets create user tables

enum UserRole {
  EMPLOYEE
  TECHNICIAN
  CENTER_MANAGER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)

  requestedTickets     Ticket[]            @relation("TicketRequester")
  managedTickets       Ticket[]            @relation("TicketCenterManager")
  assignedTickets      Ticket[]            @relation("TicketAssignee")
  commentsAuthored     Comment[]           @relation("CommentAuthor")
  ticketHistoryActions TicketHistory[]     @relation("TicketHistoryActor")
  assignmentFrom       AssignmentHistory[] @relation("AssignmentFrom")
  assignmentTo         AssignmentHistory[] @relation("AssignmentTo")
  assignmentActions    AssignmentHistory[] @relation("AssignmentActor")
  notifications        Notification[]
  auditLogs            AuditLog[]          @relation("AuditLogActor")
  refreshSessions      RefreshSession[]
  idempotencyRecords   IdempotencyRecord[]

  // Optional primary/home center
  centerId Int?
  center   Center? @relation("UserPrimaryCenter", fields: [centerId], references: [id], onDelete: SetNull)

  labId Int?
  lab   Lab? @relation("UserAssignedLab", fields: [labId], references: [id], onDelete: SetNull)

  specializations UserSpecialization[]

  // Centers this user is authorized to access
  centerAccess            UserCenter[]
  notificationPreferences NotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
  @@index([centerId])
}

model Center {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(120)
  code     String    @unique @db.VarChar(30)
  isActive Boolean   @default(true)
  labs     Lab[]
  tickets  Ticket[]
  holidays Holiday[]

  // Users whose primary/home center is this center
  primaryUsers User[] @relation("UserPrimaryCenter")

  // Users authorized to access this center
  userAccess UserCenter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @db.Date
  name String   @db.VarChar(120)

  // null = applies to all centers
  centerId Int?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([centerId, date])
}

model UserCenter {
  userId    Int
  centerId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  // A user cannot be linked to the same center twice
  @@id([userId, centerId])
  // Efficiently find users authorized for a center
  @@index([centerId, userId])
}

model Lab {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(120)
  code     String  @db.VarChar(30)
  isActive Boolean @default(true)

  tickets Ticket[]

  // Users assigned to this lab
  assignedUsers User[] @relation("UserAssignedLab")

  centerId Int
  center   Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, code])
  @@index([centerId, isActive])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(50)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}

model Software {
  id              Int     @id @default(autoincrement())
  name            String  @db.VarChar(150)
  vendor          String? @db.VarChar(120)
  version         String? @db.VarChar(60)
  licenseRequired Boolean @default(false)
  isActive        Boolean @default(true)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
  @@index([vendor, name])
}

enum TicketStatus {
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SoftwareRequestType {
  INSTALLATION
  UPDATE
  UNINSTALLATION
  LICENSE
}

model Ticket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique @db.VarChar(30)

  title       String @db.VarChar(200)
  description String @db.Text

  status      TicketStatus         @default(OPEN)
  priority    TicketPriority       @default(MEDIUM)
  requestType SoftwareRequestType?

  requesterId Int
  requester   User @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  // Administrative ownership/routing
  centerManagerId Int?
  centerManager   User? @relation("TicketCenterManager", fields: [centerManagerId], references: [id], onDelete: SetNull)

  // Technical execution
  assigneeId Int?
  assignee   User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  centerId Int
  center   Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  labId Int
  lab   Lab @relation(fields: [labId], references: [id], onDelete: Restrict)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  softwareId Int?
  software   Software? @relation(fields: [softwareId], references: [id], onDelete: SetNull)

  comments          Comment[]
  history           TicketHistory[]
  assignmentHistory AssignmentHistory[]
  notifications     Notification[]

  firstResponseAt            DateTime?
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  firstResponseDueAt         DateTime?
  resolutionDueAt            DateTime?
  firstResponseTargetMinutes Int?
  resolutionTargetMinutes    Int?
  slaCycles                  TicketSlaCycle[]
  atRiskThresholdPercent     Int              @default(75)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId, createdAt])
  @@index([centerManagerId, status, createdAt])
  @@index([assigneeId, status])
  @@index([centerId, status, createdAt])
  @@index([labId, status])
  @@index([status, priority, createdAt])
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum AssignmentType {
  CENTER_MANAGER
  TECHNICIAN
}

enum TicketHistoryEvent {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  SOFTWARE_CHANGED
  REQUEST_TYPE_CHANGED
  CENTER_CHANGED
  LAB_CHANGED
  RESOLVED
  REOPENED
  CLOSED
  CANCELLED
}

enum AssignmentEvent {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

model Comment {
  id         Int               @id @default(autoincrement())
  content    String            @db.Text
  visibility CommentVisibility @default(PUBLIC)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  authorId Int
  author   User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model TicketHistory {
  id          Int                @id @default(autoincrement())
  event       TicketHistoryEvent
  fromValue   String?            @db.VarChar(255)
  toValue     String?            @db.VarChar(255)
  description String?            @db.VarChar(500)

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  actorId Int?
  actor   User? @relation("TicketHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
}

model AssignmentHistory {
  id    Int             @id @default(autoincrement())
  event AssignmentEvent
  type  AssignmentType

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  fromUserId Int?
  fromUser   User? @relation("AssignmentFrom", fields: [fromUserId], references: [id], onDelete: SetNull)

  toUserId Int?
  toUser   User? @relation("AssignmentTo", fields: [toUserId], references: [id], onDelete: SetNull)

  assignedById Int?
  assignedBy   User? @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([ticketId, type, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([assignedById, createdAt])
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_RESOLVED
  TICKET_REOPENED
  SLA_AT_RISK
  SLA_BREACHED
}

model NotificationPreference {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  CENTER_CREATED
  CENTER_UPDATED
  LAB_CREATED
  LAB_UPDATED
  SOFTWARE_CREATED
  SOFTWARE_UPDATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  ROLE_CHANGED
  AUTHENTICATION_EVENT
}

model Notification {
  id      Int              @id @default(autoincrement())
  type    NotificationType
  title   String           @db.VarChar(150)
  message String           @db.VarChar(500)
  readAt  DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  ticketId  Int?
  ticket    Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  dedupeKey String? @unique @db.VarChar(191)

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([ticketId, createdAt])
}

model SlaPolicy {
  id                     Int            @id @default(autoincrement())
  priority               TicketPriority @unique
  firstResponseMinutes   Int
  resolutionMinutes      Int
  isActive               Boolean        @default(true)
  atRiskThresholdPercent Int            @default(75)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum SlaCycleOutcome {
  MET
  BREACHED
  CANCELLED
}

model TicketSlaCycle {
  id          Int @id @default(autoincrement())
  cycleNumber Int

  startedAt     DateTime @default(now())
  dueAt         DateTime
  targetMinutes Int

  resolvedAt DateTime?
  outcome    SlaCycleOutcome?

  ticketId               Int
  ticket                 Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  atRiskThresholdPercent Int    @default(75)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  pausedAt           DateTime?
  totalPausedMinutes Int       @default(0)

  @@unique([ticketId, cycleNumber])
  @@index([ticketId, startedAt])
  @@index([dueAt, resolvedAt])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  action     AuditAction
  entityType String      @db.VarChar(100)
  entityId   String      @db.VarChar(100)
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(500)

  actorId Int?
  actor   User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model RefreshSession {
  id Int @id @default(autoincrement())

  // Groups rotated tokens belonging to one login session.
  familyId String @db.Char(36)

  // Store only a hash of the raw refresh token.
  tokenHash String @unique @db.VarChar(255)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  // Optional session metadata.
  userAgent String? @db.VarChar(500)
  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model TicketNumberCounter {
  year     Int @id
  sequence Int @default(0)
}

model IdempotencyRecord {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  key            String   @db.VarChar(128)
  requestHash    String   @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}

enum TechnicianSpecialization {
  SOFTWARE
  HARDWARE
  NETWORK
}

model UserSpecialization {
  userId         Int
  specialization TechnicianSpecialization
  createdAt      DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, specialization])
  @@index([specialization, userId])
}
